.version 7.0
.target sm_70
.address_size 64

// Two CTAs, one thread each. Tickets remain oracle-driven during local execution;
// a separate scoped-RMW memory proof must force them to be 0 and 1 in either order.
.visible .entry atomic_dispatch(
    .param .u64 Counter,
    .param .u64 X,
    .param .u64 Y
) {
    .reg .u64 %rd<3>;
    .reg .u32 %r<3>;
    .reg .pred %p<2>;

    ld.param.u64 %rd0, [Counter];
    ld.param.u64 %rd1, [X];
    ld.param.u64 %rd2, [Y];
    atom.global.relaxed.gpu.add.u32 %r0, [%rd0], 1;
    setp.eq.u32 %p0, %r0, 0;
    @%p0 bra ITEM_A;
    setp.eq.u32 %p1, %r0, 1;
    @%p1 bra ITEM_B;
    bra DONE;
ITEM_A:
    mov.u32 %r1, 1;
    st.global.u32 [%rd1], %r1;
    bra DONE;
ITEM_B:
    mov.u32 %r2, 2;
    st.global.u32 [%rd2], %r2;
DONE:
    ret;
}
