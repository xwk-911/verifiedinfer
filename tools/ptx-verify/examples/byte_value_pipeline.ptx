.version 7.0
.target sm_70
.address_size 64

// One thread: a real store followed by a load of the same u32 word.
// The reference proof binds Ptr to model address 64; runtime allocation is separate.
.visible .entry byte_value_pipeline(.param .u64 Ptr, .param .u32 Value)
{
    .reg .u64 %p;
    .reg .u32 %v;
    .reg .u32 %r;
    ld.param.u64 %p, [Ptr];
    ld.param.u32 %v, [Value];
    st.global.u32 [%p], %v;
    ld.global.u32 %r, [%p];
    ret;
}
