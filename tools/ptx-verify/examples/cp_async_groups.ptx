// Group/wait trace fixture. No destination is consumed before completion.
.version 7.0
.target sm_80
.address_size 64
.visible .entry cp_async_groups(.param .u64 X)
{
    .shared .align 16 .b8 tile[16];
    .reg .u64 %x;
    ld.param.u64 %x, [X];
    cp.async.ca.shared.global [tile], [%x], 4;
    cp.async.commit_group;
    cp.async.ca.shared.global [tile+4], [%x+4], 4;
    cp.async.commit_group;
    cp.async.ca.shared.global [tile+8], [%x+8], 8;
    cp.async.wait_group 1;
    cp.async.wait_group 0;
    cp.async.wait_all;
    ret;
}
