.version 8.0
.target sm_90a
.address_size 64
.visible .entry hopper_mbarrier_no_complete()
{
  .shared .align 8 .b8 gate[8];
  .reg .pred %ready;
  mbarrier.init.shared::cta.b64 [gate],1;
  mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 _,[gate],16;
  mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %ready,[gate],0;
  ret;
}
