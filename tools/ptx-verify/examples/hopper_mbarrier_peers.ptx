.version 8.0
.target sm_90a
.address_size 64
.visible .entry hopper_mbarrier_peers()
{
  .shared .align 8 .b8 gate[8];
  .reg .u64 %bar;
  .reg .u32 %lane;
  .reg .pred %leader;
  .reg .pred %ready;
  mov.u64 %bar,gate;
  mov.u32 %lane,%tid.x;
  setp.eq.u32 %leader,%lane,0;
  @!%leader bra READY;
  mbarrier.init.shared::cta.b64 [%bar],1;
READY:
  bar.sync 0;
  @!%leader bra WAIT;
  mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 _,[%bar],16;
  mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [%bar],16;
WAIT:
  mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %ready,[%bar],0;
  @!%ready bra WAIT;
  bar.sync 0;
  @!%leader bra DONE;
  mbarrier.inval.shared::cta.b64 [%bar];
DONE:
  ret;
}
