.version 8.0
.target sm_90a
.address_size 64
.visible .entry hopper_tma_copy(.param .u64 MAP)
{
  .shared .align 8 .b8 gate[8];
  .shared .align 16 .b8 tile[32];
  .reg .u64 %map;
  .reg .u64 %bar;
  .reg .u64 %dst;
  .reg .s32 %x;
  .reg .s32 %y;
  .reg .pred %ready;
  ld.param.u64 %map,[MAP];
  mov.u64 %bar,gate;
  mov.u64 %dst,tile;
  mov.u32 %x,2;
  mov.u32 %y,1;
  mbarrier.init.shared::cta.b64 [%bar],1;
  fence.proxy.async.shared::cta;
  mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 _,[%bar],32;
  cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%dst],[%map,{%x,%y}],[%bar];
WAIT:
  mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %ready,[%bar],0;
  @!%ready bra WAIT;
  mbarrier.inval.shared::cta.b64 [%bar];
  ret;
}
