.version 7.0
.target sm_80
.address_size 64
.visible .entry mma_probe(.param .u64 A, .param .u64 B, .param .u64 C)
{
  .reg .u32 %lane;
  .reg .u64 %a;
  .reg .u64 %b;
  .reg .u64 %c;
  .reg .u64 %ao;
  .reg .u64 %bo;
  .reg .b32 %ra<4>;
  .reg .b32 %rb<2>;
  .reg .f32 %acc<4>;
  ld.param.u64 %a, [A];
  ld.param.u64 %b, [B];
  ld.param.u64 %c, [C];
  mov.u32 %lane, %tid.x;
  mul.wide.u32 %ao, %lane, 16;
  mul.wide.u32 %bo, %lane, 8;
  add.u64 %a, %a, %ao;
  add.u64 %b, %b, %bo;
  add.u64 %c, %c, %ao;
  ld.global.b32 %ra0, [%a];
  ld.global.b32 %ra1, [%a+4];
  ld.global.b32 %ra2, [%a+8];
  ld.global.b32 %ra3, [%a+12];
  ld.global.b32 %rb0, [%b];
  ld.global.b32 %rb1, [%b+4];
  mov.f32 %acc0, 0f00000000;
  mov.f32 %acc1, 0f00000000;
  mov.f32 %acc2, 0f00000000;
  mov.f32 %acc3, 0f00000000;
  mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32
    {%acc0,%acc1,%acc2,%acc3}, {%ra0,%ra1,%ra2,%ra3}, {%rb0,%rb1}, {%acc0,%acc1,%acc2,%acc3};
  st.global.f32 [%c], %acc0;
  st.global.f32 [%c+4], %acc1;
  st.global.f32 [%c+8], %acc2;
  st.global.f32 [%c+12], %acc3;
  ret;
}
