// Hand-written valid PTX, not a fabricated trace. One CTA; n <= blockDim.x.
.version 7.0
.target sm_70
.address_size 64
.visible .entry out_of_bounds(.param .u64 src, .param .u64 dst, .param .u32 n)
{
    .reg .u32 %r<4>;
    .reg .u64 %rd<6>;
    .reg .pred %p;
    ld.param.u64 %rd0, [src];
    ld.param.u64 %rd1, [dst];
    ld.param.u32 %r0, [n];
    mov.u32 %r1, %tid.x;
    setp.ge.u32 %p, %r1, %r0;
    @%p bra DONE;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd0, %rd2;
    add.u64 %rd4, %rd1, %rd2;
    ld.global.u32 %r2, [%rd3];
    st.global.u32 [%rd4+4096], %r2;
DONE:
    ret;
}
