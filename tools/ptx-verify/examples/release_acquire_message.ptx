// Two-thread CTA: publish DATA, signal FLAG, poll FLAG, export observed DATA.
// A successful finite run does not prove polling termination or physical UB freedom.
.version 7.0
.target sm_70
.address_size 64
.visible .entry release_acquire_message(.param .u64 DATA,.param .u64 FLAG,.param .u64 OUT)
{
  .reg .u64 %data;
  .reg .u64 %flag;
  .reg .u64 %out;
  .reg .u32 %index;
  .reg .u32 %seen;
  .reg .u32 %value;
  .reg .pred %p;
  ld.param.u64 %data,[DATA];
  ld.param.u64 %flag,[FLAG];
  ld.param.u64 %out,[OUT];
  mov.u32 %index,%tid.x;
  setp.eq.u32 %p,%index,0;
  @!%p bra POLL;
  st.global.u32 [%data],42;
  st.release.gpu.global.u32 [%flag],1;
  ret;
POLL:
  ld.acquire.gpu.global.u32 %seen,[%flag];
  setp.eq.u32 %p,%seen,0;
  @%p bra POLL;
  ld.global.u32 %value,[%data];
  st.global.u32 [%out],%value;
  ret;
}
