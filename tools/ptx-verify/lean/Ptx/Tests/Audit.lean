-- imported name matching an authored public theorem is in the audited set.
open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let names := env.constants.fold (init := ([] : List Name)) fun acc name info =>
    if name.toString.startsWith "Ptx." && info.isTheorem then name :: acc else acc
  for name in names do
    logInfo m!"PUBLIC_THEOREM {name}"
